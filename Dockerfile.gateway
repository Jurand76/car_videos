FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    chromium \
    ffmpeg \
    nginx \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libgtk-3-0 \
    libnss3 \
    libx11-xcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
  && rm -rf /var/lib/apt/lists/*

ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
ENV REMOTION_BROWSER_EXECUTABLE=/usr/bin/chromium

WORKDIR /app

COPY package.json package-lock.json ./
COPY scripts/patch-remotion-content-length.js ./scripts/
COPY scripts/patch-remotion-node-env.js ./scripts/
COPY scripts/patch-remotion-process-update.js ./scripts/
COPY scripts/patch-remotion-index-html.js ./scripts/
RUN npm ci

COPY server ./server
COPY panel ./panel
COPY hub ./hub
COPY service ./service
COPY src ./src
COPY public ./public
COPY generated ./generated
COPY remotion.config.ts tsconfig.json ./
COPY scripts/patch-remotion-content-length.js ./scripts/
COPY scripts/patch-remotion-node-env.js ./scripts/
COPY scripts/patch-remotion-process-update.js ./scripts/
COPY scripts/patch-remotion-index-html.js ./scripts/
COPY docker/nginx-studio.conf /etc/nginx/conf.d/default.conf
COPY docker/studio-entrypoint.sh /usr/local/bin/studio-entrypoint.sh

RUN mkdir -p generated/video-users generated/exports public/uploads/audio public/uploads/exterior public/uploads/interior \
  && chmod +x /usr/local/bin/studio-entrypoint.sh \
  && rm -f /etc/nginx/sites-enabled/default \
  && node scripts/patch-remotion-content-length.js \
  && node scripts/patch-remotion-node-env.js \
  && node scripts/patch-remotion-process-update.js \
  && node scripts/patch-remotion-index-html.js

ENV NODE_ENV=production
EXPOSE 4000

CMD ["npx", "tsx", "server/index.ts"]
