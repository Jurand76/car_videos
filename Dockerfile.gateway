FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    chromium \
    ffmpeg \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libgtk-3-0 \
    libnss3 \
    libx11-xcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
  && rm -rf /var/lib/apt/lists/*

ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
ENV REMOTION_BROWSER_EXECUTABLE=/usr/bin/chromium

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY server ./server
COPY panel ./panel
COPY hub ./hub
COPY src ./src
COPY public ./public
COPY generated ./generated
COPY remotion.config.ts tsconfig.json ./

RUN mkdir -p generated/video-users generated/exports public/uploads/audio public/uploads/exterior public/uploads/interior

ENV NODE_ENV=production
EXPOSE 4000

CMD ["npx", "tsx", "server/index.ts"]
