# AUTKA.PL — jedyne źródło konfiguracji (produkcja i dev)
# Skopiuj: cp project.env.example project.env
# project.env jest w .gitignore — klucze nie trafią do gita

# --- Baza danych (PostgreSQL / Docker) ---
POSTGRES_USER=carphotos
POSTGRES_PASSWORD=carphotos
POSTGRES_DB=carphotos
DATABASE_URL=postgresql+asyncpg://carphotos:carphotos@localhost:5432/carphotos
# Dla kontenera API (Docker Desktop → postgres car_photos na hoście :5432)
DOCKER_DATABASE_URL=postgresql+asyncpg://carphotos:carphotos@postgres:5432/carphotos

# --- Auth (JWT API zdjęć + NextAuth) ---
JWT_SECRET=change-me-to-a-long-random-secret-key-32chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
NEXTAUTH_URL=http://localhost:3010
NEXTAUTH_SECRET=change-me-to-another-long-random-secret

# --- CORS ---
CORS_ORIGINS=http://localhost:3010,http://localhost:4000

# --- Next.js (publiczne URL-e) ---
NEXT_PUBLIC_API_URL=http://localhost:8010
# Ten sam URL dla proxy plików po stronie serwera Next (miniatury w edytorze)
API_URL=http://localhost:8010
NEXT_PUBLIC_GATEWAY_URL=http://localhost:4000

# --- AI: DeepSeek (tekst / flow wideo) ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- AI: OpenAI (wideo + generowanie zdjęć GPT Image) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com
OPENAI_ADMIN_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=high
OPENAI_IMAGE_SIZE=auto

# Wymuszenie providera tekstu w wideo: deepseek | openai
# AI_PROVIDER=deepseek

# --- API zdjęć (upload, serie) ---
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=20
SERIES_PARALLEL_WORKERS=3

# --- Gateway wideo + integracja modułów ---
PORT=4000
PHOTOS_WEB_URL=http://localhost:3010
PHOTOS_API_URL=http://localhost:8010
STUDIO_URL=http://localhost:3000
HUB_URL=http://localhost:3010/hub
